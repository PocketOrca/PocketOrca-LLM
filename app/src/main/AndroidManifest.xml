<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dawoer.npullm">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- vc101: voice memo (ChatMedia WAV recorder) — runtime request alone is
         silently denied without this static declaration (requestPermissions
         returns denied with no dialog). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>

    <application
        android:label="PocketOrca-LLM"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- targetSdk 31+ gate: vendor public libs are hidden from the app
             classloader namespace unless declared here. Required by the ocl/cpu
             profiles (JNI in-process loads libOpenCL.so via the sphal channel). -->
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- T5 keep-alive: hosts llama-server while running so it survives
             Activity death and Doze. vc70: dataSync -> specialUse — dataSync
             FGS has a 6h/24h quota on Android 15 (OneUI enforces hard);
             a long-running local LLM server exhausted it in the field
             (crash loop at app start). specialUse has no time quota and
             is the legitimate type for user-driven local inference. -->
        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local LLM inference server (llama.cpp) with LAN endpoint"/>
        </service>

        <!-- vc122: independent LAN search endpoint (configurable port,
             SearXNG-compatible JSON). Own lifecycle, own notification channel;
             never touches the llama-server service. specialUse = same
             no-quota rationale as ServerService. Absolute class name (vc81:
             aapt2 expands relative names against the sed'd package in the
             beta variant). -->
        <service
            android:name="com.dawoer.npullm.search.SearchForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local LAN web-search endpoint (SearXNG-compatible JSON, port configurable in the search page)"/>
        </service>

        <!-- vc141: RAG 知识库独立服务（:8082）。与搜索服务同款形态：独立进程、
             独立通知通道（rag_server_v1）、key 门、绝不碰 llama-server 服务。
             specialUse = 同 no-quota 理由。类名绝对化（vc81 教训）。 -->
        <service
            android:name="com.dawoer.npullm.rag.RagForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local RAG knowledge-base endpoint (sqlite-backed vector index, port configurable in the search page)"/>
        </service>
    </application>
</manifest>
